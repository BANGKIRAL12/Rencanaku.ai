{
  "name": "rencanaku.ai",
  "version": "1.0.0",
  "description": "aplikasi pendamping perencanaan proyek berbasis AI. Aplikasi membantu pengguna mengembangkan gagasan menjadi persyaratan yang terstruktur, dokumen konteks proyek, keputusan teknis, arsitektur, rencana implementasi, tugas, prompt coding agent, serta siklus perbaikan prompt berdasarkan hasil dan kesalahan yang dilaporkan dari coding agent eksternal.",
  "keywords": [
    "ai",
    "agent",
    "rencana"
  ],
  "homepage": "https://github.com/BANGKIRAL12/Rencanaku.ai#readme",
  "bugs": {
    "url": "https://github.com/BANGKIRAL12/Rencanaku.ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BANGKIRAL12/Rencanaku.ai.git"
  },
  "license": "ISC",
  "author": "kiraladitya",
  "type": "module",
  "main": "src/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/assets/app.css",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:unit": "vitest run test/unit",
    "test:integration": "vitest run test/integration",
    "lint": "node --check src/server.js && node --check src/app.js && node --check scripts/doctor.js && node --check scripts/migrate.js && node --check scripts/db-check.js",
    "check": "npm run lint && npm test",
    "doctor": "node scripts/doctor.js",
    "db:migrate": "node scripts/migrate.js",
    "db:check": "node scripts/db-check.js"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.4",
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/language": "^6.13.1",
    "@codemirror/lint": "^6.9.7",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.15",
    "better-sqlite3": "^13.0.3",
    "commander": "^15.0.0",
    "dotenv": "^18.0.8",
    "ejs": "^3.1.10",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "marked": "^18.1.1",
    "winston": "^3.19.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.3",
    "supertest": "^7.3.1",
    "tailwindcss": "^4.3.3",
    "vitest": "^5.0.5"
  }
}
