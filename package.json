{
  "name": "rencanaku.ai",
  "version": "1.0.0",
  "description": "aplikasi pendamping perencanaan proyek berbasis AI. Aplikasi membantu pengguna mengembangkan gagasan menjadi persyaratan yang terstruktur, dokumen konteks proyek, keputusan teknis, arsitektur, rencana implementasi, tugas, prompt coding agent, serta siklus perbaikan prompt berdasarkan hasil dan kesalahan yang dilaporkan dari coding agent eksternal.",
  "keywords": [
    "ai",
    "agent",
    "rencana"
  ],
  "homepage": "https://github.com/BANGKIRAL12/Rencanaku.ai#readme",
  "bugs": {
    "url": "https://github.com/BANGKIRAL12/Rencanaku.ai/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/BANGKIRAL12/Rencanaku.ai.git"
  },
  "license": "ISC",
  "author": "kiraladitya",
  "type": "module",
  "main": "src/server.js",
  "directories": {
    "doc": "docs"
  },
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1 && vitest run",
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "build:css": "npx @tailwindcss/cli -i ./src/styles/input.css -o ./public/assets/app.css",
    "test:watch": "vitest",
    "check": "npm test"
  },
  "dependencies": {
