# Salin ke .env lalu isi nilainya. JANGAN commit .env.
# Hasilkan secret acak, contoh:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000
HOST=localhost
BASE_URL=http://localhost:3000/

# Wajib minimal 32 karakter, nilai unik per instalasi.
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
CSRF_SECRET=ganti-dengan-secret-acak-lain-minimal-32-karakter

LOG_LEVEL=info

# Penyimpanan data.
# DATA_DIR adalah satu-satunya akar untuk database, file, backup, log,
# temp, dan config. Nilai relatif dihitung dari folder kerja aplikasi,
# nilai absolut dipakai untuk deployment server (mis. /srv/rencanaku/data).
# Isi DATA_DIR TIDAK BOLEH berada di dalam folder public/.
DATA_DIR=data

# Lokasi database relatif terhadap DATA_DIR, atau path absolut.
# Gunakan file::memory: hanya untuk pengujian.
DATABASE_URL=file:app.sqlite

# Root penyimpanan file (lampiran, dokumen, backup isi) relatif terhadap DATA_DIR.
FILE_STORAGE_PATH=files

# Mode jurnal SQLite. Default "wal" (lihat ADR 0004).
# Ubah ke "delete" hanya bila DATA_DIR berada di filesystem jaringan
# yang tidak mendukung WAL, dan selalu backup lewat API backup SQLite.
SQLITE_JOURNAL_MODE=wal
SQLITE_BUSY_TIMEOUT_MS=5000

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
