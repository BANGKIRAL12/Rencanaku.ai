# Salin ke .env lalu isi nilainya. JANGAN commit .env.
# Hasilkan secret acak, contoh:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"

NODE_ENV=development
PORT=3000
HOST=localhost
BASE_URL=http://localhost:3000/

# Wajib minimal 32 karakter, nilai unik per instalasi.
SESSION_SECRET=ganti-dengan-secret-acak-minimal-32-karakter
CSRF_SECRET=ganti-dengan-secret-acak-lain-minimal-32-karakter

LOG_LEVEL=info

DATABASE_URL=file:data/app.sqlite
FILE_STORAGE_PATH=data/files

RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100
