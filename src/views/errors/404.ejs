<%- include('../partials/head', { title: 'Halaman Tidak Ditemukan' }) %>

<section class="flex flex-col items-center justify-center py-12 text-center">
  <p class="mb-4 text-6xl font-bold text-primary-500">404</p>
  <h1 class="mb-2 text-2xl font-semibold">Halaman Tidak Ditemukan</h1>
  <p class="mb-8 max-w-md text-zinc-300">
    Maaf, halaman yang Anda cari tidak tersedia. Periksa kembali alamatnya
    atau kembali ke beranda.
  </p>
  <a href="/" class="btn btn-primary">Kembali ke Beranda</a>
  <% if (typeof requestId !== 'undefined' && requestId) { %>
    <p class="mt-6 text-xs text-zinc-500">ID Permintaan: <%= requestId %></p>
  <% } %>
</section>

<%- include('../partials/foot') %>
