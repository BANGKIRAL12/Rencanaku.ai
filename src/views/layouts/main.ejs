<!DOCTYPE html>
<html lang="id">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title %></title>
    <link rel="stylesheet" href="/assets/css/app.css">
</head>
<body class="bg-surface-base text-white min-h-screen flex flex-col">
    <header class="bg-surface-sidebar border-b border-white/5 p-4">
        <div class="container mx-auto flex items-center justify-between">
            <h1 class="text-xl font-bold">Rencanaku.ai</h1>
            <nav>
                <ul class="flex space-x-4">
                    <li><a href="/" class="hover:text-primary-400">Dashboard</a></li>
                    <li><a href="/projects" class="hover:text-primary-400">Proyek</a></li>
                    <li><a href="/settings" class="hover:text-primary-400">Pengaturan</a></li>
                </ul>
            </nav>
        </div>
    </header>

    <main class="flex-1 container mx-auto p-4">
        <%- body %>
    </main>

    <footer class="bg-surface-sidebar border-t border-white/5 p-4 text-center text-sm text-zinc-400">
        &copy; <%= new Date().getFullYear() %> Rencanaku.ai - Aplikasi Pendamping Perencanaan Proyek
    </footer>

    <!-- JavaScript -->
    <script src="/assets/js/main.js"></script>
